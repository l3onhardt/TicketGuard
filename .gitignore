# 原始资料与可再生成的中间产物：不入库
data/raw/
data/interim/
data/synthetic/

# 评测报告（可再生成）
reports/

# 真实数据一律不得出现在仓库；以防万一
**/*真实*
**/real/

# Codex 派发记录（提示词、事件流、汇报）
.codex-runs/

# 模型文件
models/
*.gguf
*.safetensors
*.onnx

# Python
__pycache__/
*.pyc
.venv/
build/
dist/
*.spec
*.egg-info/

# Rust 构建产物（Cargo.lock 要入库：这是可执行程序，依赖版本必须锁定）
target/

# 交付文件夹（tg.exe + data/，由 cargo build --release 的产物拼出来，可再生成）
dist/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
.DS_Store

# 自带工具链和依赖源码（沙箱构建用，体积大，可重新生成：tools/codex/make-toolchain.sh）
.toolchain/

# 本机配置、凭据和私钥：不得提交到公开仓库
.env
.env.*
secrets/
credentials/
.ssh/
.aws/
id_rsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*.keystore

# 原始资料及导出的文档、压缩包只留在本机
*.doc
*.docx
*.xls
*.xlsx
*.pdf
*.zip
*.7z
*.rar
